# NEXA Social Network - Expanded Production Environment Variable Specification
# Copy to .env on production app servers and populate values from Key Vault / Secrets Manager

# Server Runtime Environment
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://nexa.app
DATA_SOURCE=oracle
LOG_LEVEL=info

# Hosted Oracle Database & Wallet Connectivity
DB_USER=NEXA_USER
DB_PASSWORD=REPLACE_WITH_UNIQUE_SECURE_PASSWORD
DB_CONNECT_STRING=tcps://adb.us-ashburn-1.oraclecloud.com:1522/g89b..._nexa_high.adb.oraclecloud.com?wallet_location=/etc/oracle/wallet
TNS_ADMIN=/etc/oracle/wallet
DB_POOL_MIN=5
DB_POOL_MAX=50
DB_POOL_INCREMENT=2

# Cryptographic Authentication & Cookie Security (Generate 64+ char random hex strings)
JWT_ACCESS_SECRET=REPLACE_WITH_32_CHAR_MIN_CRYPTO_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_32_CHAR_MIN_CRYPTO_RANDOM_REFRESH_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=true

# Redis Cache & Socket.IO Cluster Adapter
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis.internal.nexa.app:6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# Object Storage & CDN (OCI Object Storage / S3 Compatible)
STORAGE_PROVIDER=oci_object_storage
OCI_OBJECT_STORAGE_BUCKET=nexa-prod-media
OCI_OBJECT_STORAGE_NAMESPACE=ax192837
CDN_BASE_URL=https://cdn.nexa.app

# Upload Quotas & Resumable Chunk Limits
MAX_CHUNK_SIZE_MB=5
MAX_MEDIA_SIZE_MB=500
UPLOAD_SESSION_EXPIRY_MINUTES=60
CLEANUP_CRON_INTERVAL=0 3 * * *

# Music Rights Engine Integration
MUSIC_RIGHTS_API_KEY=REPLACE_WITH_MUSIC_PROVIDER_SERVER_KEY

# SMTP Notification Gateway
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_API_KEY
SMTP_FROM=noreply@nexa.app

# Outbox & Media Processing Background Workers
OUTBOX_POLL_INTERVAL_MS=2000
MEDIA_WORKER_CONCURRENCY=4

# Health & Readiness Probes
HEALTH_CHECK_PATH=/api/health
READY_CHECK_PATH=/api/health/ready
