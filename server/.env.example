# Nexa Server Environment Configuration Template
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Data Source Mode: 'oracle' (for live Oracle DB) or 'mock' (for in-memory testing)
DATA_SOURCE=oracle

# Oracle Database Connection Credentials
DB_USER=NEXA_USER
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DB_CONNECT_STRING=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_INCREMENT=1

# JWT Authentication Secrets (Must be at least 32 random characters in production)
JWT_ACCESS_SECRET=YOUR_32_BYTE_RANDOM_ACCESS_TOKEN_SECRET_KEY
JWT_REFRESH_SECRET=YOUR_32_BYTE_RANDOM_REFRESH_TOKEN_SECRET_KEY
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=true

LOG_LEVEL=info
