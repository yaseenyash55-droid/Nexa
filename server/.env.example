# Nexa Server Environment Configuration Template
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database Provider ('postgres' for Cloud PostgreSQL / Supabase, or 'oracle' for Oracle)
DATABASE_PROVIDER=postgres

# PostgreSQL Connection Credentials (Required when DATABASE_PROVIDER=postgres)
# Example for Supabase Pooler: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/nexa_db
PG_POOL_MIN=1
PG_POOL_MAX=10
PG_SSL=false

# Canonical Oracle Database Connection Credentials (Required when DATABASE_PROVIDER=oracle)
DB_USER=NEXA_USER
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD_HERE
DB_CONNECT_STRING=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_INCREMENT=1

# JWT Authentication Secrets (Must be at least 32 random characters in production)
JWT_ACCESS_SECRET=YOUR_32_BYTE_RANDOM_ACCESS_TOKEN_SECRET_KEY
JWT_REFRESH_SECRET=YOUR_32_BYTE_RANDOM_REFRESH_TOKEN_SECRET_KEY
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Object Storage & CDN (OCI Object Storage / S3 Compatible)
# Set STORAGE_PROVIDER=s3 in production; STORAGE_PROVIDER=local is permitted in development only
STORAGE_PROVIDER=local
S3_ENDPOINT=https://ax192837.compat.objectstorage.us-ashburn-1.oraclecloud.com
S3_REGION=us-ashburn-1
S3_BUCKET=nexa-media-bucket
S3_ACCESS_KEY_ID=your_s3_or_oci_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_oci_secret_access_key
CDN_BASE_URL=https://cdn.nexa.app

# Transactional email over HTTPS (recommended for Render Free, which blocks SMTP ports)
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=YOUR_VERIFIED_BREVO_SENDER_EMAIL
BREVO_SENDER_NAME=Nexa

# WebRTC calling. Keep disabled until a production TURN service is configured.
# Comma-separate multiple URLs. Prefer a Coturn REST shared secret so the API
# can issue short-lived per-user credentials. The shared secret stays in Render
# and is never returned to the website or Android APK.
WEBRTC_CALLING_ENABLED=false
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
WEBRTC_TURN_SHARED_SECRET=YOUR_COTURN_REST_SHARED_SECRET
WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
# Managed providers that issue one fixed TURN user/password can use these two
# variables instead of WEBRTC_TURN_SHARED_SECRET.
WEBRTC_TURN_USERNAME=YOUR_TURN_USERNAME
WEBRTC_TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL

# NEXA AI Configuration
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

LOG_LEVEL=info
