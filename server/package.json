{
  "name": "nexa-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "vitest run --exclude tests/oracle.integration.test.ts",
    "test:unit": "vitest run --exclude tests/oracle.integration.test.ts",
    "test:integration": "vitest run tests/oracle.integration.test.ts",
    "db:migrate:postgres": "tsx scripts/run_postgres_migrations.ts",
    "db:test:postgres": "tsx scripts/test_postgres_connection.ts",
    "verify:prod": "tsx scripts/verify_production_workflow.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@upstash/vector": "^1.2.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.18.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.8.0",
    "oracledb": "^6.5.0",
    "pg": "^8.23.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "artillery": "^2.0.34",
    "artillery-engine-socketio-v3": "^1.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
