# Nexa - Full-Stack Oracle Social Environment Variables

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Oracle Database Connection Settings
DB_USER=NEXA_USER
DB_PASSWORD=replace_with_secure_password
DB_CONNECT_STRING=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_INCREMENT=1

# JWT Authentication Secrets
JWT_ACCESS_SECRET=generate_a_unique_random_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=generate_a_different_unique_random_secret_of_at_least_32_characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Required before enabling MFA. Generate independently; never commit the value.
MFA_ENCRYPTION_KEY=generate_a_unique_random_key_of_at_least_32_characters

# Persistent Object Storage & CDN (S3 / OCI Compatible)
# Set STORAGE_PROVIDER=s3 or STORAGE_PROVIDER=local (local permitted in development only)
STORAGE_PROVIDER=local
S3_ENDPOINT=https://ax192837.compat.objectstorage.us-ashburn-1.oraclecloud.com
S3_REGION=us-ashburn-1
S3_BUCKET=nexa-media-bucket
S3_ACCESS_KEY_ID=your_s3_or_oci_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_or_oci_secret_access_key
CDN_BASE_URL=https://cdn.nexa.app

# Logging
LOG_LEVEL=info
