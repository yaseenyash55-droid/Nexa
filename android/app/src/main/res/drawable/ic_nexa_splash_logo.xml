<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Outer Rounded Frame -->
    <path
        android:pathData="M20,10 H100 A10,10 0 0 1 110,20 V100 A10,10 0 0 1 100,110 H20 A10,10 0 0 1 10,100 V20 A10,10 0 0 1 20,10 Z"
        android:fillColor="#151E2E"
        android:strokeColor="#1E293B"
        android:strokeWidth="2" />

    <!-- Nexa Stylized "N" Core Vector -->
    <path
        android:pathData="M42,38 L42,82 L52,82 L52,56 L70,82 L80,82 L80,38 L70,38 L70,64 L52,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="38"
                android:endX="80"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#6366F1" />
                <item android:offset="0.5" android:color="#818CF8" />
                <item android:offset="1.0" android:color="#06B6D4" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Brand Cyan & Emerald Accents -->
    <path
        android:pathData="M42,38 L52,38 L52,46 L42,46 Z"
        android:fillColor="#06B6D4" />

    <path
        android:pathData="M70,74 L80,74 L80,82 L70,82 Z"
        android:fillColor="#10B981" />
</vector>
