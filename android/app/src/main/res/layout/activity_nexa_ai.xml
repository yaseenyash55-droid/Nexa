<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Main AI Chat Content View -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background_card"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/text_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_explore"
                    app:tint="@color/brand_cyan"
                    android:contentDescription="AI Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAiTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NEXA AI"
                            android:textColor="@color/text_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBetaBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"
                            android:text="BETA"
                            android:textColor="@color/brand_cyan"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAiStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Online • Intelligent Assistant"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnAiSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="AI Settings"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btnToggleHistory"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Chat History"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Offline Banner -->
        <TextView
            android:id="@+id/tvOfflineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/error_red"
            android:gravity="center"
            android:padding="6dp"
            android:text="NEXA AI requires an active internet connection."
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Quick Prompts Horizontal Scroll -->
        <HorizontalScrollView
            android:id="@+id/hsvQuickPrompts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_dark"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tvOfflineBanner">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPromptExplain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🔍 Explain concept"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPromptCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="✍️ Generate post caption"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPromptBrainstorm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="💡 Brainstorm ideas"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPromptCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="💻 Code assistant"
                    android:textColor="@color/text_white"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Messages Recycler View -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAiMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/layoutComposer"
            app:layout_constraintTop_toBottomOf="@id/hsvQuickPrompts"
            app:stackFromEnd="true" />

        <!-- Empty State Welcome -->
        <LinearLayout
            android:id="@+id/llEmptyWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintBottom_toTopOf="@id/layoutComposer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsvQuickPrompts">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_explore"
                app:tint="@color/brand_cyan"
                android:contentDescription="Welcome AI" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Welcome to NEXA AI"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxWidth="280dp"
                android:text="Ask anything, draft social posts, summarize text, or debug code with real-time streaming."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Composer Bar -->
        <LinearLayout
            android:id="@+id/layoutComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <EditText
                android:id="@+id/etAiInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="Ask NEXA AI..."
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <!-- Stop Generation Button (Visible while streaming) -->
            <Button
                android:id="@+id/btnStopGeneration"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/error_red"
                android:paddingHorizontal="12dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Send Button -->
            <ImageButton
                android:id="@+id/btnAiSend"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_message_sent"
                android:contentDescription="Send Message"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_send"
                app:tint="@color/text_white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation Drawer for Chat History -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/background_card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI Conversations"
                android:textColor="@color/text_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNewChat"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/brand_indigo"
                android:paddingHorizontal="10dp"
                android:text="+ New"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border_dark" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversationsDrawer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/tvEmptyConversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="No conversation history yet."
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
