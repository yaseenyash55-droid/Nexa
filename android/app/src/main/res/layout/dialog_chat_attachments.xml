<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#151E2E"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Share to Conversation"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="2">

        <!-- 1. Local Storage / Files -->
        <LinearLayout
            android:id="@+id/btnAttachFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="#1E293B"
                android:padding="14dp"
                android:src="@drawable/ic_folder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                app:tint="#38BDF8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Files / Storage"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2. Photos / Gallery -->
        <LinearLayout
            android:id="@+id/btnAttachGallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="#1E293B"
                android:padding="14dp"
                android:src="@drawable/ic_gallery"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                app:tint="#A855F7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gallery"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3. Camera -->
        <LinearLayout
            android:id="@+id/btnAttachCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="#1E293B"
                android:padding="14dp"
                android:src="@drawable/ic_camera"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                app:tint="#EC4899" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Camera"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 4. Stickers -->
        <LinearLayout
            android:id="@+id/btnAttachStickers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="#1E293B"
                android:padding="14dp"
                android:src="@drawable/ic_sticker"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                app:tint="#F59E0B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stickers"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. GIFs -->
        <LinearLayout
            android:id="@+id/btnAttachGif"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="#1E293B"
                android:padding="14dp"
                android:src="@drawable/ic_gif"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize50Percent"
                app:tint="#10B981" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="GIFs"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />
        </LinearLayout>

    </GridLayout>
</LinearLayout>
