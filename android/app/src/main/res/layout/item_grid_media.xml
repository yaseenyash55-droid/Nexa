<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:layout_margin="2dp"
    app:cardBackgroundColor="#151E2E"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="#1E293B"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivGridThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Media thumbnail"
            android:scaleType="centerCrop" />

        <!-- Reel / Video overlay badge -->
        <LinearLayout
            android:id="@+id/badgeVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_unread_badge"
            android:backgroundTint="#88000000"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_video"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Post text preview overlay if text only -->
        <TextView
            android:id="@+id/tvGridTextSnippet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
